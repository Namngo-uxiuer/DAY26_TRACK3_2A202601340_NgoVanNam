# Copy this file to .env only if your terminal/workflow loads .env files.
# Do not commit the real .env file. The server itself reads environment variables.

# Required only for Streamable HTTP. Generate a long random value locally.
MCP_AUTH_TOKEN=replace-with-a-long-random-token

# Optional HTTP settings.
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
